# Database connection (PostgreSQL via asyncpg)
DATABASE_URL=your_database_url

# Clerk Authentication
CLERK_JWKS_URL=https://<clerk-domain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...
# Optional: when set, JWT `iss` claim must match (your Clerk Frontend API URL)
CLERK_ISSUER=https://<clerk-domain>.clerk.accounts.dev

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ROUTER=gemini-2.5-flash-lite
GEMINI_MODEL_VISION=gemini-2.5-flash-lite
GEMINI_MODEL_TUTOR=gemini-3.5-flash-lite
GEMINI_MODEL_DRAW=gemini-3.5-flash-lite

# Limits (optional, defaults shown)
# AI_RATE_LIMIT_PER_MINUTE=20
# SNAPSHOT_RETENTION=50
# GEMINI_MAX_ATTEMPTS=3
